{
  "name": "example-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal TypeScript example project (lint + unit tests + Playwright e2e) used as a scratch target for unity-swarm-reviewer.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
